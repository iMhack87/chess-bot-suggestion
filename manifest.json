{
  "manifest_version": 3,
  "name": "Coach Amical — Suggestions Stockfish (chess.com)",
  "version": "1.3.0",
  "description": "Suggère le meilleur coup avec Stockfish pendant une partie amicale sur chess.com. À utiliser uniquement avec l'accord des deux joueurs.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "engine-sw2.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "vendor/chess.js",
        "levels.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Coach amical — réglages"
  }
}