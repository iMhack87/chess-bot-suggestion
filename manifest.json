{
  "manifest_version": 3,
  "name": "Coach Amical — Suggestions Stockfish (chess.com)",
  "version": "1.0.0",
  "description": "Suggère le meilleur coup avec Stockfish pendant une partie amicale sur chess.com. À utiliser uniquement avec l'accord des deux joueurs.",
  "permissions": ["offscreen", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["vendor/chess.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
